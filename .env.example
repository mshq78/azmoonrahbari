# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (MySQL 8 or a compatible MariaDB) --------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=azmoon
DB_PASSWORD=
DB_NAME=azmoonrahbari
DB_POOL_SIZE=10

# --- Sessions and cookies ------------------------------------------------
# REQUIRED. At least 32 characters, random, unique per environment.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value logs everyone out.
SESSION_SECRET=

PARTICIPANT_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# Must be true in production (the app refuses to start otherwise).
COOKIE_SECURE=false
# Optional; leave empty unless cookies must span subdomains.
COOKIE_DOMAIN=

# Set to true when running behind a reverse proxy (nginx, Caddy, a load
# balancer) so client IPs and the request protocol are read from the
# X-Forwarded-* headers.
TRUST_PROXY=false

# Comma-separated origins allowed to make cookie-authenticated mutations.
# Leave empty to accept only the request's own host.
# Example: https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# --- Uploads -------------------------------------------------------------
# Persistent directory for uploaded images; back this up alongside the database.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# --- Static client -------------------------------------------------------
CLIENT_DIST_DIR=./client/dist

# --- Rate limits (per IP, per 15 minutes) --------------------------------
RATE_LIMIT_ADMIN_LOGIN_PER_15MIN=10
RATE_LIMIT_START_PER_15MIN=30
RATE_LIMIT_FINALIZE_PER_15MIN=40

# --- scripts/create-admin.ts (optional; CLI flags take precedence) -------
# Used only when creating or resetting the admin account; do not keep a real
# password here.
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=
