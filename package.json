{
  "name": "azmoonrahbari",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "«وقت تصمیم، شبیه کدومی؟» — Persian RTL decision-style game (API + SPA, single deployable process)",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/server.js",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "seed:content": "tsx scripts/seed-content.ts",
    "create:admin": "tsx scripts/create-admin.ts",
    "clean": "rm -rf client/dist server/dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.19.0"
  }
}
